rules_version = '2';

// ============================================================================
// Barてきな？ 会員管理アプリ — Firestore セキュリティルール
// ----------------------------------------------------------------------------
// 匿名認証(Firebase Authentication の Anonymous Sign-in)を導入し、
// 「このアプリを一度でも開いた人」だけが読み書きできるようにしている。
// アプリ内のPIN・スタッフコードは、あくまで「アプリの画面に入るための鍵」で
// あり、データベースへの直接アクセスまでは防げないため、それとは別に
// request.auth != null (匿名ログイン済みであること)を全コレクションで必須化した。
//
// これにより、URLを知っているだけの第三者が、アプリを経由せず直接
// Firestore を読み書きすることはできなくなる。ただし「アプリを一度開けば
// 誰でも匿名ログインできる」仕組みなので、店舗専用の端末からしかURLを
// 知られない小規模な個人経営バーのアプリという前提のもとでの対策であり、
// 完全な個人認証(スタッフ本人であることの証明)ではないことはオーナーも
// 承知の上で採用している。
//
// 前提として、Firebaseコンソール → Authentication → Sign-in method で
// 「匿名」を有効にしておく必要がある(無効のままだとアプリ自体が
// データを読み書きできなくなる)。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 会員データ・来店履歴(全件)・非会員の売上記録:
    // アプリの主要機能(会員一覧・会計・分析)に必須のため、匿名ログイン済みなら読み書き可。
    match /members/{memberId} {
      allow read, write: if request.auth != null;
    }
    match /guestSales/{saleId} {
      allow read, write: if request.auth != null;
    }
    match /visitLog/{logId} {
      allow read, write: if request.auth != null;
    }

    // 設定(スタッフコード・オーナーPIN・料金設定): こちらも匿名ログイン済みなら読み書き可。
    // アプリ側では、この中の値(staffAccess.code / app.ownerPin)と、
    // ユーザーが入力した値をクライアントJSで突き合わせてゲートしているだけであり、
    // Firestore のルールでそれを守ることはできない(突破されても会員データ本体は
    // 上の request.auth != null で守られている)。
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
