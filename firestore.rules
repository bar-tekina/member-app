rules_version = '2';

// ============================================================================
// Barてきな？ 会員管理アプリ — Firestore セキュリティルール
// ----------------------------------------------------------------------------
// セキュリティ上のトレードオフ（必ず読んでください / README.md にも同じ内容を記載）:
//
// このアプリには Firebase Authentication が設定されておらず、スタッフ/オーナーの
// 区別は「アプリ内のPIN・スタッフコード入力（クライアント側のJSチェックのみ）」で
// 行っている。Firestore のセキュリティルールは「誰がログインしているか」を見て
// 判断する仕組みなので、Auth なしでは「正しいPINを知っている人だけ書き込みを許可」
// というルールを安全に書くことができない（ルール側は、クライアントが送ってくる
// 値を信用するしかなく、それは「鍵のかかっていないドアに『関係者以外立入禁止』の
// 張り紙をする」のと変わらないため）。
//
// そのため、現時点では下記の通り「全コレクション・全ドキュメントで読み書きを
// 誰にでも許可する」というシンプルな構成にしている。これは
//   ・店舗専用の端末からしかURLを知られない小規模な個人経営バーのアプリであること
//   ・公開登録用の #join ページ自体が「ログインなしで誰でも書き込める」ことを
//     意図した機能であること（お客様自身のスマホから会員登録してもらうため）
// という実態に合わせた、現実的なリスク許容範囲での判断であり、オーナーも
// このトレードオフに同意済みという前提で採用している。
//
// 将来的にもっと厳格にしたい場合は、Firebase Authentication（匿名認証 or
// スタッフ用メール/パスワード等）を導入し、ルール側で request.auth を見て
// 判定する形に書き換えることを推奨する。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 会員データ・来店履歴(全件)・非会員の売上記録:
    // アプリの主要機能（会員一覧・会計・分析）に必須のため、読み書きともに公開。
    match /members/{memberId} {
      allow read, write: if true;
    }
    match /guestSales/{saleId} {
      allow read, write: if true;
    }
    match /visitLog/{logId} {
      allow read, write: if true;
    }

    // 設定(スタッフコード・オーナーPIN・料金設定): こちらも Auth が無いため
    // 読み書きともに公開。アプリ側では、この中の値（staffAccess.code /
    // app.ownerPin）と、ユーザーが入力した値をクライアントJSで突き合わせて
    // ゲートしているだけであり、Firestore のルールでそれを守ることはできない。
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
